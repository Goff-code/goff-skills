// ExtendScript may have no native JSON object. Never execute a manifest as JavaScript.
function posterLayerReadJSON(file) {
    file.encoding = "UTF-8";
    if (!file.open("r")) throw Error("无法读取清单 " + file.fsName);
    var s;
    try { s = file.read().replace(/^\uFEFF/, ""); } finally { file.close(); }
    if (typeof JSON !== "undefined" && JSON.parse) return JSON.parse(s);
    var i = 0, esc = {'"':'"', '\\':'\\', '/':'/', b:'\b', f:'\f', n:'\n', r:'\r', t:'\t'};
    function bad() { throw Error("JSON 格式错误，字符位置 " + i); }
    function space() { while (i < s.length && /[ \t\r\n]/.test(s.charAt(i))) i++; }
    function string() {
        var result = "", c, hex;
        if (s.charAt(i++) !== '"') bad();
        while (i < s.length) {
            c = s.charAt(i++);
            if (c === '"') return result;
            if (c.charCodeAt(0) < 32) bad();
            if (c === "\\") {
                c = s.charAt(i++);
                if (c === "u") {
                    hex = s.substr(i, 4);
                    if (!/^[0-9a-f]{4}$/i.test(hex)) bad();
                    result += String.fromCharCode(parseInt(hex, 16)); i += 4;
                } else if (esc.hasOwnProperty(c)) result += esc[c];
                else bad();
            } else result += c;
        }
        bad();
    }
    function value() {
        space();
        var c = s.charAt(i), key, m;
        if (c === '"') return string();
        if (c === "[" || c === "{") {
            var array = c === "[", end = array ? "]" : "}", out = array ? [] : {};
            i++; space();
            if (s.charAt(i) === end) { i++; return out; }
            while (i < s.length) {
                if (array) out.push(value());
                else {
                    space(); key = string(); space();
                    if (s.charAt(i++) !== ":" || key === "__proto__") bad();
                    out[key] = value();
                }
                space(); c = s.charAt(i++);
                if (c === end) return out;
                if (c !== ",") bad();
            }
            bad();
        }
        m = /^(true|false|null|-?(?:0|[1-9]\d*)(?:\.\d+)?(?:[eE][+-]?\d+)?)/.exec(s.substr(i));
        if (!m) bad();
        i += m[0].length;
        if (m[0] === "true") return true;
        if (m[0] === "false") return false;
        if (m[0] === "null") return null;
        return Number(m[0]);
    }
    var result = value(); space(); if (i !== s.length) bad();
    return result;
}
